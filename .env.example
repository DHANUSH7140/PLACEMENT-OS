# ============================================================
# PLACEMENT OS - Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION CREDENTIALS
# ============================================================

# Google Cloud Platform & Firebase Configuration
GCP_PROJECT_ID=placement-os-hackathon
GCP_REGION=us-central1
FIRESTORE_DATABASE_ID=(default)

# Cloud Storage Bucket for documents (resumes, reports, PPTs, READMEs)
GCS_STORAGE_BUCKET=placement-os-documents.appspot.com

# Service Account Path (Local Development / Testing Only)
# In production on Cloud Run, use Workload Identity / default credentials
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Gemini AI API Configuration (Used for question hints, enrichment, solution generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Ingestion Pipeline Settings
INGESTION_BATCH_SIZE=50
INGESTION_SIMILARITY_THRESHOLD=0.88
ENABLE_GEMINI_ENRICHMENT=true

# Scheduler Security (Shared Secret Token for Member 4 / Cloud Scheduler to call ingestion endpoint)
SCHEDULER_SECRET_TOKEN=generate_a_secure_token_here
